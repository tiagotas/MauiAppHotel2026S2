<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>
    
    <VerticalStackLayout Padding="10"
                         VerticalOptions="Center">

        <Label Text="Cálculo da Diária"
               FontFamily="IndieFlower"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center"
               FontSize="45"
               Margin="0, 50, 0, 50"/>

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Gray600}">
            <VerticalStackLayout Padding="10">
                <Grid ColumnDefinitions="*, *, *"
                      RowDefinitions="Auto, Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" />
                    <Label Grid.Row="0" Grid.Column="1" 
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>               
                    <Stepper x:Name="stp_adultos" Grid.Row="0" Grid.Column="2"
                             Minimum="1" Maximum="5"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}" />
                    <Stepper x:Name="stp_criancas" Grid.Row="1" Grid.Column="2"
                             Minimum="0" Maximum="5"/>
                </Grid>

                <Label Text="Selecione sua Acomodação:"
                       HorizontalTextAlignment="Center"
                       Margin="0, 20, 0, 5"/>
                <Picker x:Name="pck_quarto" />

                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource Gray500}"
                        Margin="0, 20, 0, 20">
                    
                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *"
                          RowSpacing="10" Padding="10">
                        
                        <Label Grid.Row="0" Grid.Column="0" Text="Data Check-in:" />
                        <DatePicker x:Name="dtpck_checkin" Grid.Row="0" Grid.Column="1" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Data Check-out:" />
                        <DatePicker x:Name="dtpck_checkout" Grid.Row="1" Grid.Column="1" />
                        
                    </Grid>
                </Border>

                <Button Text="Calcular!" />

            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
    
</ContentPage>